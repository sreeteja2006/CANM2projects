{
    "problem": {
        "equation": "y'' = F(x,y,y')",
        "domain": {
            "start": 0,
            "end": 1
        },
        "grid": {
            "N": 512
        }
    },

    "boundary_conditions": {
        "left": {
            "a": 3,
            "b": -9,
            "c": -2
        },
        "right": {
            "a": 0,
            "b": 1,
            "c": 0.0625
        }
    },

    "functions": {
        "F": "2*y**3",
        "Fy": "6*y**2",
        "Fyp": "0"
    },

    "solver": {
        "tolerance": 1e-8,
        "max_iterations": 50
    },

    "postprocessing": {
        "analytical_solution": "1/(x+3)",
        "compute_error": true
    }
}

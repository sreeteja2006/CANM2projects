{
    "problem": {
        "equation": "y'' = F(x,y,y')",
        "domain": {
            "start": 0,
            "end": 1
        },
        "grid": {
            "N": 134217728
        }
    },

    "boundary_conditions": {
        "left": {
            "a": 1,
            "b": 0,
            "c": 0
        },
        "right": {
            "a": 1,
            "b": 0,
            "c": -1
        }
    },

    "functions": {
        "F": "(-yp**2)/(y + 1e-4)",
        "Fy": "(yp**2)/(y + 1e-4)**2",
        "Fyp": "(-2*yp)/(y + 1e-4)"
    },

    "solver": {
        "tolerance": 1e-8,
        "max_iterations": 100
    },

    "postprocessing": {
        "analytical_solution": "1e-4*(np.sqrt(100020000 * x + 1) - 1)",
        "compute_error": true
    }
}
